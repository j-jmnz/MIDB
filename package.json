{
	"name": "midb",
	"version": "0.0.1",
	"license": "Apache-2.0",
	"scripts": {
		"dev": "bun run vite dev",
		"dev:debug": "export NODE_OPTIONS='--inspect' && vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "bun run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun ./db/scripts/migrate.ts",
		"db:seed": "bun ./db/scripts/seed.ts",
		"db:seed:movies": "bun ./db/scripts/seedMovies.ts",
		"db:seed:um": "bun ./db/scripts/seedUnconsenting.ts",
		"db:backfill:tmdb": "bun ./db/scripts/backfillTmdb.ts"
	},
	"devDependencies": {
		"@faker-js/faker": "^10.4.0",
		"@loom-io/fs": "^0.6.1",
		"@playwright/test": "latest",
		"@storybook/addon-svelte-csf": "^5.0.0",
		"@storybook/svelte": "^9.0.0",
		"@storybook/sveltekit": "^9.0.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.21.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/jest-dom": "^6.1.4",
		"@testing-library/svelte": "^5.0.0",
		"@types/bun": "^1.0.0",
		"@types/jsdom": "latest",
		"@typescript-eslint/eslint-plugin": "^8.60.1",
		"@typescript-eslint/parser": "^8.60.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^0.11.0",
		"eslint-plugin-svelte": "^3.19.0",
		"jest-dom": "^4.0.0",
		"jsdom": "latest",
		"postcss": "^8.4.31",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.0.0",
		"storybook": "^9.0.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.3.0",
		"tslib": "^2.4.1",
		"typescript": "^5.0.0",
		"vite": "^8.0.0",
		"vitest": "^4.0.0"
	},
	"type": "module",
	"dependencies": {
		"@teamhanko/hanko-elements": "^2.6.0",
		"csv-parse": "^6.2.1",
		"drizzle-orm": "^0.45.2",
		"jose": "^6.2.3",
		"marked": "^18.0.4",
		"nanoid": "^5.0.3",
		"nodemailer": "^8.0.10",
		"postgres": "^3.4.3",
		"remixicon": "^4.9.1",
		"rxjs": "^7.8.1"
	}
}
